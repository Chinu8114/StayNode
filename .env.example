# Copy to .env and tweak for your environment.
# docker compose automatically reads .env in the same folder.

# --- Web ---
WEB_HOST_PORT=8080

# --- MySQL ---
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change_me_root
DB_NAME=staynode
DB_USER=staynode
DB_PASSWORD=change_me_app

# --- API ---
# MUST be at least 32 bytes long. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-long-random-secret-at-least-32-bytes
# Lock CORS down in production, e.g. https://staynode.example.com
CORS_ORIGINS=*
SPRING_PROFILE=prod
